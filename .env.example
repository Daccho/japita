LLM_BASE_URL=        # our vLLM endpoint, e.g. http://<amd-host>:8000/v1
LLM_MODEL=google/gemma-4-26B-A4B-it
LLM_API_KEY=
LLM_BACKEND_LABEL=vLLM on AMD Instinct (AMD Developer Cloud)
LLM_TIMEOUT_SECONDS=  # optional, per model call (default 120; one retry on connection errors, 429, 5xx)
EVOLUS_API_BASE=https://api.evolus.ai/api/v1
EVOLUS_CHAT_BASE=https://api.evolus.ai/v1
EVOLUS_API_KEY=
EVOLUS_TIMEOUT_SECONDS=  # optional, per Evolus agent call (default 120)
EVOLUS_APPLICATION_ID=
EVOLUS_AGENT_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_EXTRACTOR_ID= # optional
MCP_SERVER_KEY=      # option A only
APP_ORIGIN=http://localhost:3000   # web app origin: CORS, CSRF origin check, secure cookie (comma-separate several)
DATABASE_URL=postgresql+psycopg://japita:japita@localhost:5432/japita   # docker compose up -d db
ADMIN_KEY=          # required for drawing review Regenerate/Delete; never use NEXT_PUBLIC_ for this key
DRAWING_TIMEOUT_SECONDS=60  # complete identify/generate job budget; capped at 120 seconds
