# Copy to deploy/.env on the droplet. Never commit the real file.
SITE_HOST=            # e.g. 129-212-1-2.sslip.io (droplet IP with dashes) or your own domain
HF_TOKEN=             # Hugging Face token with Gemma license accepted
VLLM_MODEL=google/gemma-4-31B-it   # verify exact HF id; fallback google/gemma-4-26B-A4B-it or google/gemma-4-E4B-it
VLLM_MAX_MODEL_LEN=32768
VLLM_API_KEY=         # long random string: openssl rand -hex 32
POSTGRES_PASSWORD=    # openssl rand -hex 16
# Optional: point the app at TokenFactory instead while vLLM is still starting
# LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# LLM_MODEL=Gemma-4-31B-IT
# LLM_API_KEY=
# LLM_BACKEND_LABEL=AMD Radeon Cloud TokenFactory
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_AGENT_ID=
EVOLUS_WORKFLOW_ID=
